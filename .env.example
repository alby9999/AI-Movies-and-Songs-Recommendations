# Server Port (Render automatically provides $PORT, default is 5001 for local)
PORT=5001

# Google Gemini API Key (Optional for AI recommendation enhancement)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Spotify API Credentials (Optional for Spotify Web API enrichment)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
